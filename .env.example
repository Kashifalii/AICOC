# Public application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase project URL and anon key are safe for browser use when RLS is enabled
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only - never expose this key to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio Gemini (optional; deterministic audit works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_CONCURRENCY=2
AI_DAILY_LIMIT_PER_WORKSPACE=200
# Shopify custom app (optional; Demo and CSV flows work without Shopify)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products
SHOPIFY_API_VERSION=2026-04
# 32-byte base64 key for AES-256-GCM token encryption (server only)
ENCRYPTION_KEY=
